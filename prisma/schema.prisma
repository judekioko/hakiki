generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  ACCOUNTANT
  STAFF
}

enum PaymentSource {
  MPESA
  BANK
  CASH
  OTHER
}

// Why a payment does not need a supplier tax invoice. Labels and guidance live in lib/exemptions.ts.
enum ExemptReason {
  SALARIES
  IMPORTS
  INTEREST_BANK_CHARGES
  AIRLINE_TICKETS
  NON_RESIDENT
  TAX_STATUTORY
  OWN_TRANSFER
  LOAN_REPAYMENT
  NOT_AN_EXPENSE
  OTHER
}

enum InvoiceStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// Bank, mobile money and cash accounts are where money actually moves.
enum MoneyKind {
  BANK
  MOBILE_MONEY
  CASH
}

enum ItemKind {
  SERVICE
  INVENTORY
  NON_STOCK
}

enum SalesInvoiceStatus {
  DRAFT
  SENT
  VOID
}

enum JournalSource {
  SALES_INVOICE
  RECEIPT
  BILL
  PAYMENT
  PAYRUN
  MANUAL
  STOCK_ADJUSTMENT
  CREDIT_NOTE
  SUPPLIER_CREDIT
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  VOID
}

enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  INVOICED
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  CLOSED
  CANCELLED
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
}

enum ReminderTone {
  FRIENDLY
  FIRM
  FINAL
}

enum PayrollParty {
  EMPLOYEE
  EMPLOYER
}

enum PayRunStatus {
  DRAFT
  APPROVED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Business {
  id                    String             @id @default(cuid())
  name                  String
  // Tax identification number (KRA PIN in Kenya, TIN elsewhere). Column name kept from the Kenya-only version.
  kraPin                String?
  // ISO country code; drives currency, tax defaults and wording (see lib/countries.ts).
  country               String             @default("KE")
  currency              String             @default("KES")
  vatRegistered         Boolean            @default(true)
  address               String?
  phone                 String?
  email                 String?
  invoiceFooter         String?
  // Income tax rate applied to unbacked expenses when estimating tax at risk (30% for Kenyan companies).
  incomeTaxRate         Decimal            @default(30) @db.Decimal(5, 2)
  // Last month of the financial year (12 = December year end).
  yearEndMonth          Int                @default(12)
  // Monthly personal relief for the configurable payroll engine (countries without a built-in one).
  payrollPersonalRelief Decimal            @default(0) @db.Decimal(14, 2)
  // Set once the default chart of accounts and tax rates have been created.
  booksReadyAt          DateTime?
  // Books are closed through this date (inclusive): nothing dated on or before it can be added, changed or removed.
  lockedThrough         DateTime?          @db.Date
  createdAt             DateTime           @default(now())
  memberships           Membership[]
  suppliers             Supplier[]
  invoices              Invoice[]
  payments              Payment[]
  importBatches         ImportBatch[]
  accounts              Account[]
  taxRates              TaxRate[]
  journalEntries        JournalEntry[]
  customers             Customer[]
  items                 Item[]
  stockMovements        StockMovement[]
  salesInvoices         SalesInvoice[]
  receipts              Receipt[]
  employees             Employee[]
  payrollRules          PayrollRule[]
  incomeTaxBands        IncomeTaxBand[]
  payRuns               PayRun[]
  creditNotes           CreditNote[]
  auditLogs             AuditLog[]
  reconciliations       Reconciliation[]
  quotations            Quotation[]
  recurringInvoices     RecurringInvoice[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  supplierCredits       SupplierCredit[]
  paymentReminders      PaymentReminder[]
}

model Membership {
  id         String     @id @default(cuid())
  userId     String
  businessId String
  role       MemberRole @default(OWNER)
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

// ---------- Ledger ----------

model Account {
  id              String           @id @default(cuid())
  businessId      String
  code            String
  name            String
  type            AccountType
  // Stable key for accounts the app posts to automatically, e.g. "AR", "AP", "VAT_OUT". Null for user accounts.
  systemKey       String?
  moneyKind       MoneyKind?
  description     String?
  isArchived      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines           JournalLine[]
  reconciliations Reconciliation[]

  @@unique([businessId, code])
  @@unique([businessId, systemKey])
}

model JournalEntry {
  id         String        @id @default(cuid())
  businessId String
  date       DateTime
  memo       String
  sourceType JournalSource
  // Id of the document that produced this entry. Entries are rebuilt whenever the document changes.
  sourceId   String?
  createdAt  DateTime      @default(now())
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines      JournalLine[]

  @@index([businessId, date])
  @@index([businessId, sourceType, sourceId])
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  accountId   String
  debit       Decimal      @default(0) @db.Decimal(16, 2)
  credit      Decimal      @default(0) @db.Decimal(16, 2)
  description String?
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Set when this line has been ticked off against a bank, mobile money or cash statement.
  reconciliationId String?
  reconciliation   Reconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([reconciliationId])
}

model TaxRate {
  id         String   @id @default(cuid())
  businessId String
  name       String
  rate       Decimal  @db.Decimal(6, 3)
  isDefault  Boolean  @default(false)
  isArchived Boolean  @default(false)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ---------- Contacts ----------

model Supplier {
  id             String           @id @default(cuid())
  businessId     String
  name           String
  kraPin         String?
  phone          String?
  email          String?
  // Other spellings seen on M-Pesa/bank statements, e.g. "JOHN SUPPLIES LTD", used for matching.
  aliases        String[]         @default([])
  createdAt      DateTime         @default(now())
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  credits        SupplierCredit[]

  @@index([businessId])
}

model Customer {
  id                String             @id @default(cuid())
  businessId        String
  name              String
  taxId             String?
  phone             String?
  email             String?
  address           String?
  // Statement names this customer pays from, used to match incoming money.
  aliases           String[]           @default([])
  createdAt         DateTime           @default(now())
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  salesInvoices     SalesInvoice[]
  receipts          Receipt[]
  creditNotes       CreditNote[]
  quotations        Quotation[]
  recurringInvoices RecurringInvoice[]
  reminders         PaymentReminder[]

  @@index([businessId])
}

// ---------- Products & stock ----------

model Item {
  id                  String                 @id @default(cuid())
  businessId          String
  name                String
  sku                 String?
  kind                ItemKind               @default(SERVICE)
  unit                String?
  salePrice           Decimal                @default(0) @db.Decimal(14, 2)
  purchasePrice       Decimal                @default(0) @db.Decimal(14, 2)
  taxRateId           String?
  incomeAccountId     String?
  expenseAccountId    String?
  reorderLevel        Decimal?               @db.Decimal(14, 3)
  isArchived          Boolean                @default(false)
  createdAt           DateTime               @default(now())
  business            Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  movements           StockMovement[]
  salesLines          SalesInvoiceLine[]
  creditLines         CreditNoteLine[]
  quotationLines      QuotationLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  supplierCreditLines SupplierCreditLine[]
  recurringLines      RecurringInvoiceLine[]
  billLines           BillLine[]

  @@index([businessId])
}

model StockMovement {
  id         String        @id @default(cuid())
  businessId String
  itemId     String
  date       DateTime
  // Positive for stock in, negative for stock out.
  quantity   Decimal       @db.Decimal(14, 3)
  unitCost   Decimal       @db.Decimal(14, 4)
  sourceType JournalSource
  sourceId   String?
  note       String?
  createdAt  DateTime      @default(now())
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  item       Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([businessId, itemId, date])
  @@index([sourceType, sourceId])
}

// ---------- Sales ----------

model SalesInvoice {
  id                 String              @id @default(cuid())
  businessId         String
  customerId         String
  number             String
  issueDate          DateTime            @db.Date
  dueDate            DateTime            @db.Date
  status             SalesInvoiceStatus  @default(DRAFT)
  reference          String?
  notes              String?
  // Number from the national e-invoicing system (eTIMS, EFRIS, EBM...) once the invoice is registered there.
  taxInvoiceNumber   String?
  subtotal           Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal           Decimal             @default(0) @db.Decimal(14, 2)
  total              Decimal             @default(0) @db.Decimal(14, 2)
  createdAt          DateTime            @default(now())
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines              SalesInvoiceLine[]
  allocations        ReceiptAllocation[]
  creditAllocations  CreditAllocation[]
  // The recurring invoice that generated this one, if any.
  recurringInvoiceId String?
  recurringInvoice   RecurringInvoice?   @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)

  @@unique([businessId, number])
  @@index([businessId, issueDate])
}

model SalesInvoiceLine {
  id          String       @id @default(cuid())
  invoiceId   String
  itemId      String?
  description String
  quantity    Decimal      @db.Decimal(14, 3)
  unitPrice   Decimal      @db.Decimal(14, 2)
  // Rate copied at the time of sale so later rate changes do not alter old invoices.
  taxRate     Decimal      @default(0) @db.Decimal(6, 3)
  taxRateId   String?
  accountId   String
  lineTotal   Decimal      @db.Decimal(14, 2)
  taxAmount   Decimal      @db.Decimal(14, 2)
  position    Int          @default(0)
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item        Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
}

// Money received. Imported from statements (incoming rows) or entered by hand.
model Receipt {
  id                String              @id @default(cuid())
  businessId        String
  customerId        String?
  moneyAccountId    String?
  importBatchId     String?
  source            PaymentSource
  reference         String?
  receivedAt        DateTime
  amount            Decimal             @db.Decimal(14, 2)
  payer             String
  details           String?
  // Where any amount not applied to invoices is booked (other income, loan received...). Defaults to other income.
  categoryAccountId String?
  createdAt         DateTime            @default(now())
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer          Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  importBatch       ImportBatch?        @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  allocations       ReceiptAllocation[]

  @@unique([businessId, reference])
  @@index([businessId, receivedAt])
}

model ReceiptAllocation {
  id        String       @id @default(cuid())
  receiptId String
  invoiceId String
  amount    Decimal      @db.Decimal(14, 2)
  createdAt DateTime     @default(now())
  receipt   Receipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([receiptId, invoiceId])
}

// ---------- Purchases ----------

// A supplier bill / tax invoice received. Named Invoice from the expense-checker version of the app.
model Invoice {
  id                String                     @id @default(cuid())
  businessId        String
  supplierId        String?
  // Tax invoice number as printed by the supplier's e-invoicing device (eTIMS CU number in Kenya).
  invoiceNumber     String
  supplierName      String
  supplierPin       String?
  invoiceDate       DateTime                   @db.Date
  dueDate           DateTime?                  @db.Date
  totalAmount       Decimal                    @db.Decimal(14, 2)
  vatAmount         Decimal                    @default(0) @db.Decimal(14, 2)
  description       String?
  // Expense account used when the bill has no lines.
  categoryAccountId String?
  status            InvoiceStatus              @default(UNVERIFIED)
  fileName          String?
  fileType          String?
  fileData          Bytes?
  createdAt         DateTime                   @default(now())
  business          Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier          Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  allocations       Allocation[]
  lines             BillLine[]
  // The purchase order this bill was raised from.
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?             @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplierCredits   SupplierCredit[]
  creditAllocations SupplierCreditAllocation[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, invoiceDate])
}

model BillLine {
  id                  String  @id @default(cuid())
  invoiceId           String
  itemId              String?
  description         String
  quantity            Decimal @db.Decimal(14, 3)
  unitPrice           Decimal @db.Decimal(14, 2)
  taxRate             Decimal @default(0) @db.Decimal(6, 3)
  taxRateId           String?
  accountId           String
  lineTotal           Decimal @db.Decimal(14, 2)
  taxAmount           Decimal @db.Decimal(14, 2)
  position            Int     @default(0)
  // The purchase order line this bill line pays for, used to track what has been billed.
  purchaseOrderLineId String?
  invoice             Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item                Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderLineId])
}

// Money paid out.
model Payment {
  id                 String        @id @default(cuid())
  businessId         String
  supplierId         String?
  importBatchId      String?
  moneyAccountId     String?
  source             PaymentSource
  // M-Pesa receipt number or bank reference. Used to skip duplicates on re-import.
  reference          String?
  paidAt             DateTime
  amount             Decimal       @db.Decimal(14, 2)
  counterparty       String
  details            String?
  // Expense or liability account for any amount not applied to bills.
  categoryAccountId  String?
  exemptReason       ExemptReason?
  exemptNote         String?
  invoiceRequestedAt DateTime?
  createdAt          DateTime      @default(now())
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier           Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  importBatch        ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  allocations        Allocation[]

  @@unique([businessId, reference])
  @@index([businessId, paidAt])
}

// Links part or all of a payment to part or all of a bill.
// One bill can be paid in instalments, and one payment can settle several bills.
model Allocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
}

model ImportBatch {
  id             String        @id @default(cuid())
  businessId     String
  source         PaymentSource
  moneyAccountId String?
  fileName       String
  imported       Int
  skipped        Int
  createdAt      DateTime      @default(now())
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments       Payment[]
  receipts       Receipt[]
}

// ---------- Payroll ----------

model Employee {
  id             String    @id @default(cuid())
  businessId     String
  name           String
  employeeNumber String?
  nationalId     String?
  taxId          String?
  pensionNumber  String?
  healthNumber   String?
  phone          String?
  email          String?
  jobTitle       String?
  basicSalary    Decimal   @db.Decimal(14, 2)
  allowances     Decimal   @default(0) @db.Decimal(14, 2)
  startDate      DateTime? @db.Date
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payslips       Payslip[]

  @@index([businessId])
}

// A statutory or voluntary deduction for countries without a built-in payroll engine.
model PayrollRule {
  id          String       @id @default(cuid())
  businessId  String
  name        String
  party       PayrollParty
  // Percentage of gross pay, applied to gross capped at maxBase, then capped at maxAmount.
  rate        Decimal      @default(0) @db.Decimal(6, 3)
  fixedAmount Decimal      @default(0) @db.Decimal(14, 2)
  maxBase     Decimal?     @db.Decimal(14, 2)
  maxAmount   Decimal?     @db.Decimal(14, 2)
  // Employee deductions that reduce taxable income (e.g. pension contributions).
  preTax      Boolean      @default(false)
  position    Int          @default(0)
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// Monthly income tax bands for the configurable payroll engine. upTo null means "everything above".
model IncomeTaxBand {
  id         String   @id @default(cuid())
  businessId String
  upTo       Decimal? @db.Decimal(14, 2)
  rate       Decimal  @db.Decimal(6, 3)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model PayRun {
  id         String       @id @default(cuid())
  businessId String
  // Calendar month the pay is for, e.g. "2026-09".
  period     String
  payDate    DateTime     @db.Date
  status     PayRunStatus @default(DRAFT)
  createdAt  DateTime     @default(now())
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payslips   Payslip[]

  @@unique([businessId, period])
}

model Payslip {
  id                    String   @id @default(cuid())
  payRunId              String
  employeeId            String
  basicSalary           Decimal  @db.Decimal(14, 2)
  allowances            Decimal  @db.Decimal(14, 2)
  gross                 Decimal  @db.Decimal(14, 2)
  taxableIncome         Decimal  @db.Decimal(14, 2)
  incomeTax             Decimal  @db.Decimal(14, 2)
  employeeDeductions    Decimal  @db.Decimal(14, 2)
  employerContributions Decimal  @db.Decimal(14, 2)
  net                   Decimal  @db.Decimal(14, 2)
  // Line-by-line calculation, shown on the payslip: [{ label, amount, party }].
  breakdown             Json
  payRun                PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payRunId, employeeId])
}

// ---------- Credit notes ----------

// A reduction of what a customer owes: returned goods, a price correction, a discount given after invoicing.
// Posts the reverse of a sales invoice (debit sales and tax, credit receivables).
model CreditNote {
  id          String             @id @default(cuid())
  businessId  String
  customerId  String
  // The invoice being corrected, when there is one. The credit is applied to it automatically.
  invoiceId   String?
  number      String
  issueDate   DateTime           @db.Date
  status      CreditNoteStatus   @default(DRAFT)
  reason      String?
  // Put returned stock items back into stock at their current average cost.
  restock     Boolean            @default(false)
  subtotal    Decimal            @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal            @default(0) @db.Decimal(14, 2)
  total       Decimal            @default(0) @db.Decimal(14, 2)
  createdAt   DateTime           @default(now())
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines       CreditNoteLine[]
  allocations CreditAllocation[]

  @@unique([businessId, number])
  @@index([businessId, issueDate])
}

model CreditNoteLine {
  id           String     @id @default(cuid())
  creditNoteId String
  itemId       String?
  description  String
  quantity     Decimal    @db.Decimal(14, 3)
  unitPrice    Decimal    @db.Decimal(14, 2)
  taxRate      Decimal    @default(0) @db.Decimal(6, 3)
  taxRateId    String?
  accountId    String
  lineTotal    Decimal    @db.Decimal(14, 2)
  taxAmount    Decimal    @db.Decimal(14, 2)
  position     Int        @default(0)
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  item         Item?      @relation(fields: [itemId], references: [id], onDelete: SetNull)
}

// Part of a credit note used up against an invoice. Moves no money, so it does not touch the ledger.
model CreditAllocation {
  id           String       @id @default(cuid())
  creditNoteId String
  invoiceId    String
  amount       Decimal      @db.Decimal(14, 2)
  createdAt    DateTime     @default(now())
  creditNote   CreditNote   @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoice      SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([creditNoteId, invoiceId])
}

// ---------- Audit trail ----------

// Append-only record of who changed what. Rows are never updated or deleted by the app.
model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  // Copied at the time so the trail still reads correctly if the user is later removed.
  userName   String
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
}

// ---------- Bank reconciliation ----------

// One pass of ticking a money account's ledger lines off against a statement. Lines cleared in a completed
// reconciliation are protected from change until it is undone.
model Reconciliation {
  id               String               @id @default(cuid())
  businessId       String
  accountId        String
  statementDate    DateTime             @db.Date
  statementBalance Decimal              @db.Decimal(16, 2)
  // Cleared balance carried over from the previous completed reconciliation of this account.
  openingBalance   Decimal              @default(0) @db.Decimal(16, 2)
  status           ReconciliationStatus @default(IN_PROGRESS)
  completedAt      DateTime?
  completedBy      String?
  createdAt        DateTime             @default(now())
  business         Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account          Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lines            JournalLine[]

  @@index([businessId, accountId, statementDate])
}

// ---------- Quotations ----------

// An offer to a customer. Posts nothing to the books; converting it creates a draft sales invoice.
model Quotation {
  id         String          @id @default(cuid())
  businessId String
  customerId String
  number     String
  issueDate  DateTime        @db.Date
  expiryDate DateTime        @db.Date
  status     QuotationStatus @default(DRAFT)
  reference  String?
  notes      String?
  subtotal   Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal   Decimal         @default(0) @db.Decimal(14, 2)
  total      Decimal         @default(0) @db.Decimal(14, 2)
  // The invoice created from this quotation.
  invoiceId  String?
  createdAt  DateTime        @default(now())
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines      QuotationLine[]

  @@unique([businessId, number])
  @@index([businessId, issueDate])
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  itemId      String?
  description String
  quantity    Decimal   @db.Decimal(14, 3)
  unitPrice   Decimal   @db.Decimal(14, 2)
  taxRate     Decimal   @default(0) @db.Decimal(6, 3)
  taxRateId   String?
  accountId   String
  lineTotal   Decimal   @db.Decimal(14, 2)
  taxAmount   Decimal   @db.Decimal(14, 2)
  position    Int       @default(0)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item        Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
}

// ---------- Recurring invoices ----------

// A template that issues a sales invoice on a schedule. Lines are priced afresh each time, so tax rate and
// price changes apply to future invoices.
model RecurringInvoice {
  id          String                 @id @default(cuid())
  businessId  String
  customerId  String
  frequency   RecurrenceFrequency
  // Every N weeks / months / years.
  interval    Int                    @default(1)
  startDate   DateTime               @db.Date
  endDate     DateTime?              @db.Date
  nextRunDate DateTime               @db.Date
  dueDays     Int                    @default(14)
  // Issue as sent (posts to the books) rather than leaving a draft to review.
  autoSend    Boolean                @default(false)
  status      RecurringStatus        @default(ACTIVE)
  reference   String?
  notes       String?
  runCount    Int                    @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime               @default(now())
  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines       RecurringInvoiceLine[]
  invoices    SalesInvoice[]

  @@index([businessId, status, nextRunDate])
}

model RecurringInvoiceLine {
  id          String           @id @default(cuid())
  recurringId String
  itemId      String?
  description String
  quantity    Decimal          @db.Decimal(14, 3)
  unitPrice   Decimal          @db.Decimal(14, 2)
  taxRateId   String?
  accountId   String?
  position    Int              @default(0)
  recurring   RecurringInvoice @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  item        Item?            @relation(fields: [itemId], references: [id], onDelete: SetNull)
}

// ---------- Purchase orders ----------

// An order placed with a supplier. Posts nothing to the books: stock and the payable arrive with the bill.
// Goods received notes track what has arrived; bills raised from the order track what has been invoiced.
model PurchaseOrder {
  id           String              @id @default(cuid())
  businessId   String
  supplierId   String
  number       String
  orderDate    DateTime            @db.Date
  expectedDate DateTime?           @db.Date
  status       PurchaseOrderStatus @default(DRAFT)
  reference    String?
  notes        String?
  subtotal     Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal     Decimal             @default(0) @db.Decimal(14, 2)
  total        Decimal             @default(0) @db.Decimal(14, 2)
  createdAt    DateTime            @default(now())
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  lines        PurchaseOrderLine[]
  receipts     GoodsReceipt[]
  bills        Invoice[]

  @@unique([businessId, number])
  @@index([businessId, orderDate])
}

model PurchaseOrderLine {
  id          String             @id @default(cuid())
  orderId     String
  itemId      String?
  description String
  quantity    Decimal            @db.Decimal(14, 3)
  unitPrice   Decimal            @db.Decimal(14, 2)
  taxRate     Decimal            @default(0) @db.Decimal(6, 3)
  taxRateId   String?
  accountId   String
  lineTotal   Decimal            @db.Decimal(14, 2)
  taxAmount   Decimal            @db.Decimal(14, 2)
  position    Int                @default(0)
  order       PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item        Item?              @relation(fields: [itemId], references: [id], onDelete: SetNull)
  received    GoodsReceiptLine[]
}

// A delivery against a purchase order.
model GoodsReceipt {
  id           String             @id @default(cuid())
  businessId   String
  orderId      String
  number       String
  receivedDate DateTime           @db.Date
  note         String?
  createdAt    DateTime           @default(now())
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order        PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines        GoodsReceiptLine[]

  @@unique([businessId, number])
}

model GoodsReceiptLine {
  id          String            @id @default(cuid())
  receiptId   String
  orderLineId String
  quantity    Decimal           @db.Decimal(14, 3)
  receipt     GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine   PurchaseOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
}

// ---------- Supplier credit notes ----------

// A credit from a supplier: goods returned, an overcharge corrected, a discount given after billing.
// Posts the reverse of a bill (debit payables, credit the cost and the input tax).
model SupplierCredit {
  id          String                     @id @default(cuid())
  businessId  String
  supplierId  String
  // The bill being corrected, when there is one. The credit is applied to it automatically.
  billId      String?
  // The supplier's own credit note number.
  number      String
  creditDate  DateTime                   @db.Date
  status      CreditNoteStatus           @default(DRAFT)
  reason      String?
  // Take returned stock items out of stock (otherwise the credit is a price adjustment).
  returnStock Boolean                    @default(false)
  subtotal    Decimal                    @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal                    @default(0) @db.Decimal(14, 2)
  total       Decimal                    @default(0) @db.Decimal(14, 2)
  createdAt   DateTime                   @default(now())
  business    Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier    Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  bill        Invoice?                   @relation(fields: [billId], references: [id], onDelete: SetNull)
  lines       SupplierCreditLine[]
  allocations SupplierCreditAllocation[]

  @@unique([businessId, number])
  @@index([businessId, creditDate])
}

model SupplierCreditLine {
  id          String         @id @default(cuid())
  creditId    String
  itemId      String?
  description String
  quantity    Decimal        @db.Decimal(14, 3)
  unitPrice   Decimal        @db.Decimal(14, 2)
  taxRate     Decimal        @default(0) @db.Decimal(6, 3)
  taxRateId   String?
  accountId   String
  lineTotal   Decimal        @db.Decimal(14, 2)
  taxAmount   Decimal        @db.Decimal(14, 2)
  position    Int            @default(0)
  credit      SupplierCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  item        Item?          @relation(fields: [itemId], references: [id], onDelete: SetNull)
}

// Part of a supplier credit used up against a bill. Moves no money, so it does not touch the ledger.
model SupplierCreditAllocation {
  id        String         @id @default(cuid())
  creditId  String
  billId    String
  amount    Decimal        @db.Decimal(14, 2)
  createdAt DateTime       @default(now())
  credit    SupplierCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  bill      Invoice        @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([creditId, billId])
}

// ---------- Payment reminders ----------

// A record that an overdue-payment reminder was sent to a customer, so the same customer is not chased twice in a
// day and the history shows how many times they have been reminded.
model PaymentReminder {
  id            String          @id @default(cuid())
  businessId    String
  customerId    String
  channel       ReminderChannel
  tone          ReminderTone
  // What was overdue when the reminder went out.
  overdueAmount Decimal         @db.Decimal(14, 2)
  invoiceCount  Int
  sentBy        String
  createdAt     DateTime        @default(now())
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([customerId, createdAt])
}
